NODE_ENV=development

# --- Supabase (multi-tenant migration — specs/004-multi-tenant-supabase) ---
# Direct (session-mode, port 5432) Postgres connection string from your Supabase project —
# NOT the pgbouncer pooler on 6543. See research.md #1: RLS's SET LOCAL and LISTEN/NOTIFY
# both need a session-mode connection.
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASS=
# Project URL, used to verify Supabase Auth JWTs against its JWKS endpoint (contracts/admin-auth.md)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUD=authenticated
# A restricted, non-owner/non-superuser Postgres role — NOT the `postgres` superuser above.
# Table owners AND superusers bypass Row-Level Security regardless of FORCE ROW LEVEL SECURITY
# (verified empirically — see specs/004-multi-tenant-supabase/research.md #3 addendum), so the
# app's runtime connection (server/db/knex.js) must use this role instead, or RLS is a no-op.
# Create it once per Supabase project (SQL editor): CREATE ROLE strawberry_app LOGIN PASSWORD '...';
# then migrations (96_multi_tenant_foundation.js) grant it table access.
SUPABASE_APP_DB_USER=strawberry_app
SUPABASE_APP_DB_PASS=
# Where scripts/onboardTenant.js's Supabase invite email links back to (.../reset-password) so
# a new owner can set their password. Must match wherever strawberry-admin is actually reachable
# — for local dev with the mkcert setup below, that's https://strawberry.local:5173, NOT
# http://localhost:5173 (onboardTenant.js's fallback default if this is left unset).
ADMIN_URL=https://strawberry.local:5173

# --- Legacy self-hosted Postgres (used until the Supabase vars above are wired in) ---
DB_HOST=localhost
DB_NAME=strawberry
DB_USER=
DB_PASS=
DB_APPUSER=appuser
DB_APPUSER_PASSWORD=

BASE_URL=http://strawberry.local

# If you're having trouble figuring out the right value, set to *, and look at the
# 'access-control-allow-origin' response header on one of the API requests.
CORS_ORIGINS="*"

DOMAIN_NAME=

EMAIL_ADMIN=
# --- Email alerts (specs/005-email-open-alerts) ---
# The "From" address on "we're open" notification emails sent via POSTMARK_API_KEY below.
EMAIL_INFO=

LOG_LEVEL=debug

PORT=10000
# Server token for Postmark's **Broadcast** message stream (not transactional — see README's
# "Email alerts" section), used by POST /services/notify. For real, non-mocked test coverage
# without a live account or without actually delivering mail, use Postmark's own sandbox token,
# POSTMARK_API_TEST (accepted and processed normally, never delivered).
POSTMARK_API_KEY=

# 1048576 (1 MB) is Hapi's default
ROUTE_PAYLOAD_MAXBYTES=104857600

SERVER_HOST=0.0.0.0

STRIPE_SECRET_KEY=

STOREFRONT_URL=http://localhost:5173
